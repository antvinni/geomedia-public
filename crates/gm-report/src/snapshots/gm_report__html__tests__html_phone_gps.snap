:root { --bg: #fbfaf8; --fg: #1d1d1b; --muted: #6b6a66; --line: #e3e1dc; --card: #ffffff; --accent: #2f5d8a; --warn: #9a5b00; }
@media (prefers-color-scheme: dark) {
